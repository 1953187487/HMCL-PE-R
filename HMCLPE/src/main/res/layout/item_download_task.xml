<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@color/colorTransparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:textColor="@color/colorPureBlack"
            android:textSize="12sp"
            android:id="@+id/download_task_name"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/colorLinkBlue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:id="@+id/download_task_progress_text"/>

    </LinearLayout>

    <ProgressBar
        android:tag="tint_accent_color"
        android:layout_marginTop="3dp"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:indeterminateDrawable="@drawable/progress_indeterminate"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:id="@+id/download_task_progress"/>

</LinearLayout>