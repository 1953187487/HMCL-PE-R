<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/colorSurface">

    <LinearLayout
        android:id="@+id/main_layout"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terracotta_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terracotta_subtitle"
            android:textSize="12sp"
            android:textColor="@color/colorPureBlack"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:id="@+id/create_room_btn"
            android:background="@drawable/launcher_button_parent"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ic_baseline_donate_black"
                android:layout_gravity="center"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terracotta_create_room"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPureBlack"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terracotta_create_room_desc"
                    android:textSize="11sp"
                    android:textColor="@color/colorPureBlack"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/join_room_btn"
            android:background="@drawable/launcher_button_parent"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ic_baseline_donate_black"
                android:layout_gravity="center"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terracotta_join_room"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPureBlack"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terracotta_join_room_desc"
                    android:textSize="11sp"
                    android:textColor="@color/colorPureBlack"/>

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/colorDarkGray"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terracotta_help_title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terracotta_help_text"
            android:textSize="11sp"
            android:textColor="@color/colorPureBlack"
            android:lineSpacingMultiplier="1.3"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/connected_layout"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terracotta_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/connection_state_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/colorThird"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:background="@drawable/launcher_button_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/terracotta_room_id_label"
                android:textSize="11sp"
                android:textColor="@color/colorPureBlack"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/room_id_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"/>

        </LinearLayout>

        <LinearLayout
            android:background="@drawable/launcher_button_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/terracotta_invite_code_label"
                    android:textSize="11sp"
                    android:textColor="@color/colorPureBlack"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/invite_code_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="@color/colorPrimary"/>

            </LinearLayout>

            <Button
                android:id="@+id/copy_invite_btn"
                android:text="@string/terracotta_copy"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="6dp"
                android:background="@drawable/launcher_setting_button"/>

        </LinearLayout>

        <LinearLayout
            android:background="@drawable/launcher_button_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/terracotta_virtual_ip_label"
                    android:textSize="11sp"
                    android:textColor="@color/colorPureBlack"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/virtual_ip_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPureBlack"/>

            </LinearLayout>

            <Button
                android:id="@+id/copy_ip_btn"
                android:text="@string/terracotta_copy"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="6dp"
                android:background="@drawable/launcher_setting_button"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terracotta_connection_tip"
            android:textSize="11sp"
            android:textColor="@color/colorPureBlack"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/disconnect_btn"
            android:text="@string/terracotta_disconnect"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/launcher_setting_button"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/loading_layout"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:padding="24dp">

        <ProgressBar
            android:id="@+id/progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"/>

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terracotta_loading"
            android:textSize="13sp"
            android:textColor="@color/colorPureBlack"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</FrameLayout>
