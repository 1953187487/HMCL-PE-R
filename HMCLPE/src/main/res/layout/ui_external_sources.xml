<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ui_external_sources"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_ui_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/external_sources_title"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPureBlack"/>

                    <TextView
                        android:id="@+id/external_sources_url_text"
                        android:singleLine="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="middle"
                        android:textColor="@color/colorGray"
                        android:textSize="11sp"/>

                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/external_sources_config_button"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:background="@drawable/tile_secondary"
                        android:text="@string/external_sources_custom_url"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/colorPureBlack"/>

                    <Button
                        android:id="@+id/external_sources_refresh_button"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/tile_launch_button"
                        android:text="@string/external_sources_refresh"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPureWhite"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"/>

                </LinearLayout>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/external_sources_progress"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:max="100"
                android:progress="0"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>

            <TextView
                android:id="@+id/external_sources_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/colorGray"
                android:textSize="12sp"
                android:visibility="gone"/>

            <TextView
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/external_sources_launch_sources"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPureBlack"/>

            <LinearLayout
                android:id="@+id/external_sources_launch_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"/>

            <TextView
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/external_sources_renderers"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPureBlack"/>

            <LinearLayout
                android:id="@+id/external_sources_renderers_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"/>

            <TextView
                android:id="@+id/external_sources_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/external_sources_empty"
                android:textColor="@color/colorGray"
                android:textSize="13sp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
