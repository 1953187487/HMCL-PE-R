<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ui_main"
    android:visibility="invisible"
    android:background="@color/launcher_ui_background"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HMCL-PE-R"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPureBlack"/>

                <TextView
                    android:id="@+id/main_version_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/colorGray"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/start_ui_account"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/tile_secondary"
                android:paddingStart="10dp"
                android:paddingEnd="14dp"
                android:clickable="true"
                android:focusable="true">

                <RelativeLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:id="@+id/account_skin_face"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_steve"
                        android:layout_centerInParent="true"/>

                    <ImageView
                        android:id="@+id/account_skin_hat"
                        android:layout_width="30dp"
                        android:layout_height="30dp"/>

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/account_name_text"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/launcher_scroll_account_name"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPureBlack"/>

                    <TextView
                        android:id="@+id/account_state_text"
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/launcher_scroll_account_state"
                        android:textSize="11sp"
                        android:textColor="@color/colorGray"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/launcher_hero_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/tile_hero"
            android:padding="18dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/current_version_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/ic_grass"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前版本"
                    android:textSize="12sp"
                    android:textColor="#CCFFFFFF"/>

                <TextView
                    android:id="@+id/current_version_name_text"
                    android:singleLine="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPureWhite"/>

                <LinearLayout
                    android:id="@+id/no_version_alert_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:singleLine="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/launcher_scroll_game_none"
                        android:textSize="13sp"
                        android:textColor="#DDFFFFFF"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/launcher_play_button"
                android:layout_width="120dp"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:background="@drawable/tile_launch_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <TextView
                    android:id="@+id/launch_version_text"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_button_launch"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPureWhite"/>

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/launcher_spinner_version"
                    android:overlapAnchor="false"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@color/colorTransparent"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="4dp"
            android:text="@string/launcher_scroll_text_game"
            android:textSize="13sp"
            android:textColor="@color/colorGray"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:columnCount="3"
            android:rowCount="1"
            android:useDefaultMargins="false">

            <LinearLayout
                android:id="@+id/start_ui_game_manager"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:background="@drawable/tile_primary"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_baseline_settings_black"
                    android:background="@drawable/tile_icon_bg"
                    android:padding="6dp"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/launcher_scroll_game_manager"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPureBlack"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="管理当前版本"
                    android:textSize="11sp"
                    android:textColor="@color/colorGray"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/start_ui_version_list"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:background="@drawable/tile_primary"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/version_list_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/tile_icon_bg"
                    android:padding="6dp"
                    android:src="@drawable/ic_bookshelf"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/launcher_scroll_version_list"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPureBlack"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="安装版本 / 模组包"
                    android:textSize="11sp"
                    android:textColor="@color/colorGray"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/start_ui_download"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:background="@drawable/tile_primary"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/download_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/tile_icon_bg"
                    android:padding="6dp"
                    android:src="@drawable/ic_chest"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/launcher_scroll_download"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPureBlack"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="模组 / 资源包 / 世界"
                    android:textSize="11sp"
                    android:textColor="@color/colorGray"/>

            </LinearLayout>

        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="4dp"
            android:text="@string/launcher_scroll_text_universal"
            android:textSize="13sp"
            android:textColor="@color/colorGray"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:columnCount="3"
            android:rowCount="1"
            android:useDefaultMargins="false">

            <LinearLayout
                android:id="@+id/start_ui_external_sources"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:background="@drawable/tile_primary"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/tile_icon_bg"
                    android:padding="6dp"
                    android:src="@drawable/ic_baseline_update_black"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/main_ui_external_sources"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPureBlack"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/main_ui_external_sources_desc"
                    android:textSize="11sp"
                    android:textColor="@color/colorGray"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/start_ui_multi_player"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:background="@drawable/tile_primary"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/multiplayer_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/tile_icon_bg"
                    android:padding="6dp"
                    android:src="@drawable/ic_command"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/launcher_scroll_multi_player"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPureBlack"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="内网穿透联机"
                    android:textSize="11sp"
                    android:textColor="@color/colorGray"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/start_ui_setting"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:background="@drawable/tile_primary"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/setting_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/tile_icon_bg"
                    android:padding="6dp"
                    android:src="@drawable/ic_command"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/launcher_scroll_setting"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPureBlack"/>

                <TextView
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="启动器与游戏设置"
                    android:textSize="11sp"
                    android:textColor="@color/colorGray"/>

            </LinearLayout>

        </GridLayout>

    </LinearLayout>

</ScrollView>
