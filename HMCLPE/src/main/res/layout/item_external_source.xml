<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/external_source_item"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tile_primary"
    android:padding="12dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/external_source_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/tile_icon_bg"
        android:padding="4dp"
        android:scaleType="fitCenter"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/external_source_name"
                android:singleLine="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPureBlack"/>

            <TextView
                android:id="@+id/external_source_version"
                android:singleLine="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/tile_secondary"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textSize="11sp"
                android:textColor="@color/colorGray"/>

        </LinearLayout>

        <TextView
            android:id="@+id/external_source_description"
            android:maxLines="2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/colorGray"/>

    </LinearLayout>

    <Button
        android:id="@+id/external_source_install"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/tile_launch_button"
        android:text="@string/external_sources_install"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textColor="@color/colorPureWhite"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>

</LinearLayout>
